# ==============================================================================
# Production Environment Configuration
# ==============================================================================

NODE_ENV=production
PORT=8081
HOST=0.0.0.0

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=shein
DB_USER=root
DB_PASSWORD=YOUR_STRONG_MYSQL_PASSWORD

# Security Secrets (Must be at least 32 characters)
APP_SECRET=replace_this_with_a_long_random_app_secret_at_least_32_characters_here
JWT_SECRET=replace_this_with_a_long_random_jwt_secret_at_least_32_characters_here
CREDENTIAL_ENCRYPTION_KEY=replace_this_with_a_long_random_encryption_key_32_characters
INTERNAL_API_TOKEN=replace_this_with_a_long_random_internal_api_token_32_chars_here
SHEIN_LOCAL_API_TOKEN=replace_this_with_a_long_random_internal_api_token_32_chars_here
SEED_ADMIN_PASSWORD=replace_this_with_the_initial_admin_password

# Microservices
SHEIN_LOCAL_API_BASE_URL=http://127.0.0.1:8000
SHEIN_BASE_URL=https://ar.shein.com
PLAYWRIGHT_HEADLESS=1
SHEIN_MANUAL_LOGIN_TIMEOUT_SECONDS=1800
SHEIN_ENABLE_REMOTE_BROWSER=1
SHEIN_VNC_PASSWORD=replace_this_with_a_strong_vnc_password
SHEIN_REMOTE_BROWSER_URL=https://browser.your-domain.example/vnc/vnc.html?path=websockify&autoconnect=true&resize=scale

# Allowed Origins for CORS
ALLOWED_ORIGINS=https://your-domain.example

# Admin Account Seed (Set 1 to seed master admin account on fresh boot)
SEED_ADMIN=1
SEED_DEMO_ACCOUNTS=0
